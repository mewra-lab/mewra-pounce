{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Mewra Pounce (Extension Development Host)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js",
        "${workspaceFolder}/dist/**/*.cjs"
      ],
      "preLaunchTask": "Mewra Pounce: Build"
    }
  ]
}
